# Required — agent's EVM private key (Arc Testnet only, never use mainnet keys)
NANOCRAWL_BUYER_PRIVATE_KEY=0x...

# Optional — auto-deposit this many USDC into Gateway if balance is low (default: 1)
NANOCRAWL_AUTO_DEPOSIT=1

# Optional — initial spending cap in USDC (default: unlimited)
NANOCRAWL_BUDGET=0.10
