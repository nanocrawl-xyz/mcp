# ── Standard mode (Arc Testnet) ───────────────────────────────────────────────

# Optional — agent's EVM private key. If not set, a wallet is auto-generated at
# ~/.nanocrawl/wallet.json on first run.
NANOCRAWL_BUYER_PRIVATE_KEY=0x...

# Optional — auto-deposit this many USDC into Gateway if balance is low (default: 1)
NANOCRAWL_AUTO_DEPOSIT=1

# Optional — initial spending cap in USDC (default: unlimited)
NANOCRAWL_BUDGET=0.10

# ── Unlink privacy mode (Base Sepolia) ────────────────────────────────────────
# When both NANOCRAWL_UNLINK_MNEMONIC and NANOCRAWL_UNLINK_API_KEY are set,
# the server starts in privacy mode: payments are made from a disposable burner
# EOA funded via the Unlink ZK privacy pool. The real agent identity is shielded.

# BIP-39 mnemonic for the Unlink account (must have USDC deposited in the pool)
NANOCRAWL_UNLINK_MNEMONIC=word1 word2 word3 ...

# API key from https://hackaton-apikey.vercel.app
NANOCRAWL_UNLINK_API_KEY=

# USDC to allocate per crawl session (default: 5)
NANOCRAWL_UNLINK_SESSION_AMOUNT=5

# Unlink engine URL (default: https://staging-api.unlink.xyz)
# NANOCRAWL_UNLINK_ENGINE_URL=https://staging-api.unlink.xyz

# Base Sepolia RPC URL (default: public endpoint https://sepolia.base.org)
# RPC_URL=https://sepolia.base.org
